---
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../data/site';

const links = [
  { href: '#carta', label: 'Carta' },
  { href: '#galeria', label: 'Galería' },
  { href: '#reservar', label: 'Cómo reservar' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

{
  site.isDemo && (
    <div class="demo-banner" role="note">
      <span>Sitio de demostración: {site.name} es un negocio ficticio.</span>
      <a href={site.author.url} target="_blank" rel="noopener noreferrer">
        Diseño y desarrollo: {site.author.name}
      </a>
    </div>
  )
}

<header class="header">
  <div class="header__inner container">
    <a class="logo" href="#top" aria-label={`${site.name}, inicio`}>
      ESMALTE<span class="logo__box">CLUB</span>
    </a>

    <button class="header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menú">
      <Icon name="menu" size={22} class="icon-open" />
      <Icon name="close" size={22} class="icon-close" />
    </button>

    <nav id="site-nav" class="nav" aria-label="Secciones">
      {
        links.map((l) => (
          <a class="nav__link" href={l.href}>
            {l.label}
          </a>
        ))
      }
      <a class="btn btn--black btn--small" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
        Reservar
      </a>
    </nav>
  </div>
</header>

<script>
  // Progressive enhancement: without JS the nav is simply always visible (see CSS).
  const toggle = document.querySelector<HTMLButtonElement>('.header__toggle');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    document.documentElement.classList.add('js');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      nav.classList.toggle('nav--open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('nav--open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 861px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
