---
import { STEPS } from '../data/site';
---

<section class="section" id="reservar" aria-labelledby="reservar-title">
  <div class="container">
    <div class="section__head">
      <p class="kicker">Cómo reservar</p>
      <h2 class="section__title" id="reservar-title">Tres pasos<br />y listo</h2>
    </div>

    <ol class="steps">
      {
        STEPS.map((step, i) => (
          <li class="step">
            <span class="step__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
