---
import { MENU, site } from '../data/site';
---

<section class="section section--paper" id="carta" aria-labelledby="carta-title">
  <div class="container">
    <div class="section__head">
      <p class="kicker">La carta</p>
      <h2 class="section__title" id="carta-title">Precios claros,<br />sin sorpresas</h2>
    </div>

    <div class="menu">
      {
        MENU.map((group) => (
          <div class="menu__group">
            <h3 class="menu__title">{group.title}</h3>
            <ul class="menu__list">
              {group.items.map((item) => (
                <li class="menu__item">
                  <div class="menu__row">
                    <span class="menu__name">{item.name}</span>
                    <span class="menu__dots" aria-hidden="true" />
                    <span class="menu__price">{item.price}</span>
                  </div>
                  <span class="menu__detail">{item.detail}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p class="section__note">
      Precios finales en pesos{site.isDemo ? ', de ejemplo para esta demo' : ''}. Efectivo, transferencia o débito.
    </p>
  </div>
</section>
