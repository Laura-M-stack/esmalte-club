---
import Icon from './Icon.astro';
import { FAQ } from '../data/site';
---

<section class="section section--paper" id="preguntas" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <div class="section__head">
      <p class="kicker">Preguntas</p>
      <h2 class="section__title" id="faq-title">Lo que<br />siempre nos<br />preguntan</h2>
    </div>

    <div class="faq">
      {
        FAQ.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              {item.q}
              <Icon name="plus" size={22} class="faq__icon" />
            </summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
